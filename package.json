{
  "name": "happy-pdf",
  "private": true,
  "version": "0.9.0",
  "description": "Happy PDF: free PDF tools that run on your device. Nothing is uploaded.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "predev": "node scripts/gen-licenses.mjs && node scripts/copy-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-licenses.mjs && node scripts/copy-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "node scripts/gen-licenses.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "app:assets": "node scripts/app-assets.mjs && capacitor-assets generate --android --ios --iconBackgroundColor '#ff9a1f' --iconBackgroundColorDark '#ff9a1f' --splashBackgroundColor '#f8f6f1' --splashBackgroundColorDark '#12110e'"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@fontsource-variable/figtree": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "lucide-react": "1.61.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
